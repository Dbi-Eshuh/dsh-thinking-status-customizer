{
  "name": "dsh-thinking-status-customizer",
  "version": "0.1.1",
  "description": "A lifecycle-safe CSS-only customizer for the DSH Web thinking status.",
  "author": {
    "name": "Dbi-Eshuh",
    "url": "https://github.com/Dbi-Eshuh"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dbi-Eshuh/dsh-thinking-status-customizer.git"
  },
  "homepage": "https://github.com/Dbi-Eshuh/dsh-thinking-status-customizer#readme",
  "bugs": {
    "url": "https://github.com/Dbi-Eshuh/dsh-thinking-status-customizer/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "web-ui",
    "css"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "assets",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "verify": "npm run check && npm test && npm run build && git diff --exit-code -- lib && npm pack --dry-run",
    "pack:dry-run": "npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.15.3",
    "esbuild": "^0.25.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
